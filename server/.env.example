PORT=3001
# Origens permitidas do front (separadas por virgula)
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175

# STUN publico basta para descobrir o IP externo
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# TURN: obrigatorio para funcionar entre redes diferentes / NAT simetrico.
# Deve casar com o `static-auth-secret` do coturn (ver docker-compose.yml).
TURN_URLS=turn:localhost:3478?transport=udp,turn:localhost:3478?transport=tcp
TURN_SECRET=troque-este-segredo
TURN_TTL_SECONDS=21600

# Host + espectadores por sala (mesh nao escala muito alem disso)
MAX_PARTICIPANTS=6

# Banco OPCIONAL. Sem esta linha o servidor roda em memoria: salas morrem com o
# host e o chat e efemero. Com ela, o codigo da sala e o historico persistem.
# Deve casar com o servico `mysql` do docker-compose.yml.
DATABASE_URL=mysql://share:share@localhost:3306/share_screen
# Quantas mensagens antigas cada participante recebe ao entrar
CHAT_HISTORY_LIMIT=100

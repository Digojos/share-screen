# Configuracao do `docker compose`. Copie para `.env` e ajuste.
#
#   cp .env.example .env
#
# Este arquivo e lido automaticamente pelo compose para substituir as
# variaveis. NAO e o mesmo que `server/.env`, que serve ao `npm run dev`.

# --- Endereco publico ---------------------------------------------------
# O MESMO valor nos dois. VITE_SIGNALING_URL e embutida no bundle em tempo de
# build, entao mudar exige `docker compose build web`.
VITE_SIGNALING_URL=https://seu-endereco
CORS_ORIGIN=https://seu-endereco

# --- Portas no host -----------------------------------------------------
# Publicadas apenas em 127.0.0.1; quem expoe para fora e o nginx, com TLS.
SERVER_PORT=3001
WEB_PORT=8080
MYSQL_PORT=3307

# --- Banco --------------------------------------------------------------
# Troque as senhas. Mesmo com o MySQL restrito a localhost, senha padrao em
# servidor e divida que uma hora vence.
MYSQL_ROOT_PASSWORD=troque-esta-senha
MYSQL_DATABASE=share_screen
MYSQL_USER=share
MYSQL_PASSWORD=troque-esta-senha-tambem

# --- Sala ---------------------------------------------------------------
MAX_PARTICIPANTS=6
HOST_GRACE_SECONDS=60

# --- TURN (opcional) ----------------------------------------------------
# Necessario apenas quando a conexao direta falha entre redes diferentes.
# O TURN_SECRET aqui precisa ser o mesmo usado pelo coturn.
# TURN_URLS=turn:seu-endereco:3478?transport=udp,turn:seu-endereco:3478?transport=tcp
# TURN_SECRET=troque-este-segredo
